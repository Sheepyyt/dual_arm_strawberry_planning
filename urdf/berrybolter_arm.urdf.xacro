  <joint name="camera_joint" type="fixed">
    <origin xyz="0.0535264795602718 0.0471423874193815 0.0242769003020624" rpy="0 0.174532925199436 0.59554890101875" />
    <parent link="${tf_prefix}link6" />
    <child link="${tf_prefix}camera_link" />
    <axis xyz="0 0 0" />
  </joint>

</robot>